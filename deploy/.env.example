# Domain pointing at this server (an A record). Caddy obtains the HTTPS certificate.
NNFX_DOMAIN=beta.example.com
# Symbols refreshed hourly from Nobitex (works from inside Iran).
NNFX_SYMBOLS="BTC/USDT ETH/USDT BTC/IRT ETH/IRT USDT/IRT"
# Order books recorded for backtests and paper runs of order-book rules (Nobitex allows a poll
# every 1-10 s). Paper runs trade the /USDT pairs: keep them in this list.
NNFX_ORDERBOOK_SYMBOLS="BTC/IRT USDT/IRT ETH/IRT BTC/USDT ETH/USDT"
NNFX_ORDERBOOK_INTERVAL=10
# Bale bot token for paper-run alerts (optional; users enter their own chat id in the site).
NNFX_BALE_TOKEN=
