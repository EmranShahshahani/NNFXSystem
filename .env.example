# Copy to .env (which is gitignored) and fill in per workstation.

# Identifies this machine in every research log line and journal entry, so
# per-workstation contribution counts can be reported after a union merge.
NNFX_WORKSTATION_ID=laptop-1

# Local bar cache. Market data never enters git; manifests do.
NNFX_CACHE_DIR=data/cache

# Exchange API keys. Create keys with TRADING permission only.
# WITHDRAWAL MUST BE DISABLED, and IP allowlisting enabled (doc 04 §6).
NNFX_EXCHANGE_ID=binance
NNFX_EXCHANGE_API_KEY=
NNFX_EXCHANGE_API_SECRET=
